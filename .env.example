# --- Auth (Auth.js) ---
# `npx auth secret` generates one. Any long random string works.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://brainverse.mooibekeken.nl/api/auth/callback/google  (and http://localhost:3000/api/auth/callback/google for dev)
# The consent screen must be user type "External" and published, or only Workspace accounts can sign in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Storage (required) ---
# Pooled Postgres connection string (Neon). The app does not run without it.
DATABASE_URL=
# Direct (unpooled) connection, used by migrations and backups. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Local development ---
# DEV_LOGIN=1 adds a passwordless "Dev login" button on /login (development builds only, never on Vercel).
DEV_LOGIN=
# The email the dev login signs in as. Any value works; it bypasses the invite list.
DEV_EMAIL=dev@localhost
