# --- Auth (Auth.js) ---
# `npx auth secret` generates one. Any long random string works.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://brainverse.mooibekeken.nl/api/auth/callback/google  (and http://localhost:3000/api/auth/callback/google for dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The one Google account that may enter. Comma-separate if you ever want a second one.
OWNER_EMAIL=hallo@mooibekeken.nl

# --- Storage ---
# Postgres connection string (Neon, Supabase or Vercel Postgres). Leave empty to run in local-only mode
# (notes then live in the browser's localStorage and are not synced).
DATABASE_URL=
